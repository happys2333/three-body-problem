.traveller { width: 100%; height: 100%; color: rgb(237,231,217); font-size: 18px; }
.gameplay-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hud-top { position: absolute; left: 28px; right: 28px; top: 24px; flex-direction: row; justify-content: space-between; align-items: flex-start; }
.mission { width: 67%; max-width: 800px; padding: 12px 18px; background-color: rgba(12,19,24,0.62); border-left-width: 2px; border-left-color: rgb(190,156,98); }
.chapter-small { font-size: 13px; color: rgb(206,178,126); margin-bottom: 7px; }
.objective { font-size: 21px; white-space: normal; }
.navigation { font-size: 13px; color: rgb(216,201,168); margin-top: 7px; white-space: normal; }
.hud-tools { flex-direction: row; flex-shrink: 0; }
.hud-tools .button { margin-left: 8px; padding: 8px 12px; font-size: 14px; }
.hud-bottom { position: absolute; left: 28px; right: 28px; bottom: 20px; align-items: center; }
.caption-card { width: 82%; max-width: 850px; padding: 15px 22px; background-color: rgba(10,17,23,0.79); margin-bottom: 12px; }
.caption { font-size: 20px; white-space: normal; -unity-text-align: middle-center; }
.action-row { flex-direction: row; justify-content: center; flex-wrap: wrap; margin-bottom: 8px; }
.action-row .button { margin: 4px 6px; }
.controls { font-size: 12px; color: rgb(205,199,183); white-space: normal; -unity-text-align: middle-center; margin-top: 10px; }
.button { min-height: 40px; background-color: rgba(24,32,39,0.95); color: rgb(236,229,214); font-size: 17px; padding: 10px 18px; border-width: 1px; border-color: rgba(180,156,113,0.45); border-radius: 2px; margin-top: 5px; margin-bottom: 5px; white-space: normal; flex-shrink: 0; }
.button:hover { background-color: rgb(99,77,45); border-color: rgb(216,180,115); }
.button:focus { border-color: rgb(229,198,139); }
.primary, .selected { background-color: rgb(126,95,49); color: rgb(255,239,204); border-color: rgb(192,158,99); }
.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(5,10,16,0.50); }
.menu-card { width: 82%; max-width: 620px; max-height: 90%; padding: 30px; background-color: rgba(12,20,27,0.96); border-width: 1px; border-color: rgba(184,151,93,0.75); }
.title-card { padding: 38px; }
.eyebrow { font-size: 11px; color: rgb(204,173,116); letter-spacing: 2px; white-space: normal; margin-bottom: 20px; }
.game-title { font-size: 48px; letter-spacing: 5px; color: rgb(247,230,195); margin-bottom: 14px; white-space: normal; }
.menu-title { font-size: 29px; color: rgb(239,216,175); margin-bottom: 16px; white-space: normal; }
.menu-description { color: rgb(213,209,195); font-size: 17px; white-space: normal; margin-bottom: 18px; }
.start-button { min-height: 52px; margin: 12px 0 20px 0; font-size: 21px; }
.dialogue-card { width: 84%; max-width: 780px; padding: 14px 20px; background-color: rgba(12,20,27,0.96); margin-bottom: 10px; border-left-width: 2px; border-left-color: rgb(190,156,98); }
.dialogue-scroll { max-height: 390px; }
.free-dialogue { margin-top: 10px; border-top-width: 1px; border-top-color: rgba(184,151,93,0.4); padding-top: 8px; }
.chat-input { min-height: 36px; }
.chat-input .unity-text-input { background-color: rgb(28,38,46); color: rgb(240,224,191); padding: 8px; }
.voice-status { font-size: 12px; color: rgb(208,190,153); white-space: normal; margin-top: 6px; }
.chat-actions { flex-direction: row; }
.chat-actions .button { margin-right: 8px; }
.compact .dialogue-scroll { max-height: 290px; }
.choice-list { flex-direction: column; }
.panel-heading { color: rgb(205,174,118); font-size: 14px; margin-top: 5px; margin-bottom: 9px; }
.dialogue-card .button { font-size: 16px; padding: 8px 14px; }
.journal-card { height: 84%; max-width: 680px; }
.journal-entries { flex-grow: 1; min-height: 60px; margin-bottom: 8px; }
.journal-text { font-size: 16px; white-space: normal; margin-bottom: 14px; color: rgb(221,214,197); }
.hypothesis { min-height: 58px; max-height: 85px; margin-bottom: 8px; flex-shrink: 0; }
.hypothesis .unity-text-input { background-color: rgb(28,38,46); color: rgb(240,224,191); padding: 10px; white-space: normal; }
.notice { position: absolute; bottom: 150px; align-self: center; width: 75%; max-width: 650px; padding: 11px 18px; background-color: rgba(13,21,27,0.94); color: rgb(239,214,166); font-size: 15px; white-space: normal; -unity-text-align: middle-center; display: none; }
.debug-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.debug-header { position: absolute; left: 24px; top: 24px; width: 42%; max-width: 430px; background-color: rgba(12,20,27,0.9); padding: 12px; }
.debug-sidebar { position: absolute; right: 24px; top: 24px; bottom: 24px; width: 38%; max-width: 340px; padding: 16px; background-color: rgba(12,20,27,0.95); border-left-width: 1px; border-left-color: rgb(185,151,94); }
.debug-scroll { flex-grow: 1; min-height: 70px; }
.debug-sidebar .button { font-size: 14px; padding: 8px 10px; }
.compact .game-title { font-size: 36px; }
.compact .menu-card { padding: 20px; }
.compact .objective { font-size: 18px; }
.compact .hud-tools { flex-direction: column; }
.compact .caption { font-size: 17px; }
.compact .dialogue-card .button { font-size: 14px; min-height: 32px; }
.travel-overlay { background-color: rgb(9,12,14); }
.travel-title { font-size: 36px; letter-spacing: 5px; color: rgb(230,205,155); -unity-text-align: middle-center; white-space: normal; margin: 20px; }
.travel-subtitle { font-size: 16px; color: rgb(177,171,153); margin-top: 20px; }
.quest-marker { position: absolute; width: 84px; align-items: center; }
.quest-arrow { width: 44px; height: 44px; font-size: 34px; color: rgb(102,244,142); -unity-text-align: middle-center; -unity-font-style: bold; }
.quest-distance { font-size: 14px; color: rgb(174,255,197); background-color: rgba(7,23,17,0.72); padding: 3px 9px; border-radius: 9px; -unity-text-align: middle-center; }
.wake-lid { position: absolute; left: 0; right: 0; background-color: rgb(0,0,0); }
.wake-top { top: 0; }
.wake-bottom { bottom: 0; }
.gobi-chat { width: 36%; max-width: 510px; align-self: flex-end; padding: 12px 16px; }
.gobi-chat .dialogue-scroll { max-height: 320px; }
.gobi-chat .button { font-size: 14px; min-height: 34px; padding: 6px 10px; }
.compact .gobi-chat { width: 75%; max-width: 510px; }
.chat-input .unity-base-text-field__input, .chat-input .unity-text-field__input { background-color: rgb(28,38,46); color: rgb(240,224,191); padding: 8px; border-color: rgb(105,118,125); border-width: 1px; }
