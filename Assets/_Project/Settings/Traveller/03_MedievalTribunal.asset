  moments:
  - title: "\u4E2D\u4E16\u7EAA \xB7 \u89E3\u91CA\u4E0E\u8D28\u8BE2"
    description: "\u65B0\u7684\u6587\u660E\u62E5\u6709\u81EA\u5DF1\u7684\u6743\u5A01\u3002\u73A9\u5BB6\u4EE5\u201C\u54E5\u767D\u5C3C\u201D\u4E3A\u6E38\u620F\u79F0\u53F7\u8FDB\u5165\u5927\u5385\uFF0C\u4E0A\u4E00\u5E55\u7684\u89C2\u5BDF\u4ECD\u4FDD\u5B58\u5728\u89C2\u5BDF\u7C3F\u3002"
    caption: "\u5B66\u8005\uFF1A\u4F60\u7684\u89E3\u91CA\uFF0C\u80FD\u540C\u65F6\u8BF4\u660E\u90A3\u4E9B\u98DE\u661F\u548C\u5F02\u5E38\u7684\u65E5\u7167\u5417\uFF1F"
    objective: "\u67E5\u770B\u6559\u7687\u3001\u5B66\u8005\u4E0E\u652F\u6301\u8005\u7684\u4F4D\u7F6E\uFF1B\u6574\u7406\u81EA\u5DF1\u7684\u5047\u8BF4\u3002"
