  moments:
  - title: "\u671D\u6B4C \xB7 \u6BB7\u5546\u738B\u90FD"
    description: "\u6570\u65E5\u884C\u8DEF\u4E4B\u540E\uFF0C\u671D\u6B4C\u51FA\u73B0\u5728\u6CB3\u8C37\u5E73\u539F\u3002\u5DE8\u6446\u73AF\u7ED5\u77F3\u780C\u91D1\u5B57\u5854\uFF1B\u72ED\u957F\u752C\u9053\u7A7F\u8FC7\u539A\u5899\uFF0C\u901A\u5411\u7EA3\u738B\u6240\u5728\u7684\u5185\u6BBF\u3002"
    caption: "\u5468\u6587\u738B\uFF1A\u5230\u4E86\u3002\u5DE8\u6446\u4E4B\u95F4\u7684\u91D1\u5B57\u5854\u5C31\u662F\u738B\u5BAB\uFF0C\u8DDF\u6211\u8D70\u8FDB\u752C\u9053\u3002"
    objective: "\u968F\u5468\u6587\u738B\u5165\u57CE\uFF0C\u7A7F\u8FC7\u91D1\u5B57\u5854\u4F4E\u77EE\u5165\u53E3\u4E0E\u77F3\u780C\u752C\u9053\u3002"
