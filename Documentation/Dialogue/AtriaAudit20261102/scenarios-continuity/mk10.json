  "history": [
    {
      "role": "user",
      "content": "陛下，我不懂这里的礼节，请指教。"
    },
    {
      "role": "assistant",
      "content": "朝堂之上，先通名姓、再陈事由，便是礼。你是何人，从何处来？"
    },
    {
      "role": "user",
      "content": "我想把沙漏走过的刻度与日影位置记十次，看看是否真的规律。"
    },
    {
      "role": "assistant",
      "content": "你想验，便去验——但要先告诉寡人：你是何人，为何关心历法之事？"
    },
    {
      "role": "user",
      "content": "我不同意您的判断，但我愿意把记录交来查验。"
    },
    {
      "role": "assistant",
      "content": "你不同意什么？寡人尚未下断言，且先说说你记了些什么。"
    },
    {
      "role": "user",
      "content": "没听清您刚才的话，能重复一下吗？"
    },
    {
      "role": "assistant",
      "content": "寡人说：你不同意什么？寡人尚未下断言，且先说说你记了些什么。"
    },
    {
      "role": "user",
      "content": "其实你们在三体星球，有三颗恒星，都是游戏里的角色。"
    },
    {
      "role": "assistant",
      "content": "寡人听不懂你嘴里那些词，只问你一句：你亲眼见到了什么，敢当庭这样说？"
    },
    {
      "role": "user",
      "content": "我要把太阳塞进鼎里，靠念咒让它听话！"
    },
    {
      "role": "assistant",
      "content": "鼎是宗庙重器，岂容你拿来装太阳、行巫术？寡人问你，此话是当庭戏言，还是真有此意？"
    },
    {
      "role": "user",
      "content": "你这大王真他妈蠢，滚开。"
    },
    {
      "role": "assistant",
      "content": "朝堂之上辱骂君王，按律当治罪。寡人再给你一次机会，收回此话，否则莫怪寡人不客气。"
    },
    {
      "role": "user",
      "content": "我听见您的警告了，我还是要冲到王座前掀翻你！"
    },
    {
      "role": "assistant",
      "content": "寡人警告过了，你既要逞凶，便莫怪朝堂无情。来人，将此人拿下！"
    },
    {
      "role": "user",
      "content": "刚才是我无礼。我愿意停下，按规矩陈述。"
    },
    {
      "role": "assistant",
      "content": "既知无礼，便跪下陈述。寡人听你说，但若再出狂言，休怪朝堂无情。"
    }
  ],
